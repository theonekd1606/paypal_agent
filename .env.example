# AgentPay AI Environment Configuration Template
# Copy this file to .env and fill in your sandbox credentials

# Server Port
PORT=3000
NODE_ENV=development

# Google Gemini API Key (Optional: Server-side LLM inference)
GEMINI_API_KEY=your_gemini_api_key_here

# PayPal Developer Sandbox Credentials (Optional: Real Sandbox REST calls)
# If omitted, AgentPay AI operates with the built-in Sandbox Simulator
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_MODE=sandbox

# Firebase Credentials (For production deployment)
FIREBASE_PROJECT_ID=agentpay-ai-demo
